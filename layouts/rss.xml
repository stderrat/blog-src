{{- /*
  rss.xml - replaces the existing RSS template for home, sections and
  taxonomy terms.

  Changes compared to the current output:
  - strict date order (newest first), independent of "weight"
  - home feed contains all content sections (incl. gitopscollection)
  - <description> carries the summary, full article in <content:encoded>
  - one <category> per category, <dc:creator> per author
  - plainify output is converted back to a string (htmlUnescape) so Hugo
    escapes it; the copyright "&" previously broke XML parsers
  - channel title names the section/term instead of the site description
*/ -}}
{{- $pages := partial "yaub/feed-pages.html" . -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- $channelTitle := site.Title -}}
{{- if not .IsHome -}}
  {{- $channelTitle = printf "%s – %s" .Title site.Title -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ $channelTitle }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description }}{{ . }}{{ else }}{{ site.Params.description }}{{ end }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with site.Copyright }}
    <copyright>{{ . | plainify | htmlUnescape }}</copyright>
    {{- end }}
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- range .GetTerms "authors" }}
      <dc:creator>{{ .LinkTitle }}</dc:creator>
      {{- end }}
      {{- range .GetTerms "categories" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
      <description>{{ with .Description }}{{ . }}{{ else }}{{ .Summary | plainify | htmlUnescape | strings.TrimSpace }}{{ end }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" (replace (string .Content) "]]>" "]]]]><![CDATA[>") | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
